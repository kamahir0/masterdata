{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterData",
  "version": "0.1.0",
  "identifier": "dev.masterdata.desktop",
  "build": { "frontendDist": "../web/dist", "devUrl": "http://localhost:1420" },
  "app": {
    "windows": [{ "label": "main", "title": "MasterData", "width": 1240, "height": 840, "minWidth": 720, "minHeight": 480, "titleBarStyle": "Overlay", "hiddenTitle": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" }
  },
  "bundle": { "active": false }
}

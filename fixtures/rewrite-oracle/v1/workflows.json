      "authority": "SOURCE-EDIT-010 / GUI-EXPLORER"
    },
    {
      "id": "external-dirty",
      "input": "save-both/input",
      "intent": "keep local edits on external change",
      "events": [
        "capture base",
        "local edit",
        "external edit same source",
        "refresh",
        "Save"
      ],
      "expected": {
        "Conflict": true,
        "localBufferAndHistoryRetained": true,
        "actualDiskOverwritten": false
      },
      "authority": "SOURCE-EDIT-008..011"
    },
    {
      "id": "overwrite-recheck",
      "input": "save-both/input",
      "intent": "overwrite only explicitly approved disk identity",
      "events": [
        "Conflict disk X",
        "authorize Overwrite X",
        "external edit disk Y before commit",
        "Overwrite"
      ],
      "expected": {
        "Conflict": true,
        "diskYRetained": true,
        "automaticRetry": false
      },
      "authority": "SOURCE-EDIT-009"
    },
    {
      "id": "outcome-unknown",
      "input": "save-both/input",
      "intent": "recover uncertain write result",
      "events": [
        "local edit",
        "inject failure after install before verification",
        "request Save again"
      ],
      "expected": {
        "outcome": "Outcome Unknown",
        "localBufferRetained": true,
        "automaticStaleRetryOrOverwrite": false,
        "freshActualSourceRecheckBeforeMutation": true
      },
      "authority": "SOURCE-EDIT-011"
    },
    {
      "id": "recovery-required",

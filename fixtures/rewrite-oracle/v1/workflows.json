      "expected": {
        "outcome": "Recovery Required",
        "normalSourceMutationAndBuildBlocked": true,
        "readInspectionPermitted": true,
        "eligiblePreviouslyBuiltPublishIndependent": true,
        "frontendFlagAloneClearsRecovery": false
      },
      "authority": "MIGRATION-010 / GUI-SHELL-CAPABILITY-001"
    },

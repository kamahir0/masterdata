{
  "format": 1,
  "scenarios": [
    {
      "id": "one-table",
      "input": "save-both/input",
      "intent": "edit schema and selected records in one context",
      "events": [
        "select separate schema",
        "select inline schema",
        "select mixed schema"
      ],
      "expected": {
        "schemaAndRecordsInOneContext": true,
        "physicalSourceSelectorWhenMultiple": true,
        "emptyTableEditableSchema": true,
        "implicitDataFileCreation": false
      },
      "authority": "GUI-UNIFIED-001..008"
    },
    {
      "id": "complex-direct",
      "input": "save-both/input",
      "intent": "edit nested values directly",
      "events": [
        "change nested scalar",
        "toggle nullable",
        "add array element",
        "remove array element",
        "close complex editor",
        "Undo"
      ],
      "expected": {
        "eachCommittedOperationUndoUnits": 1,
        "footerApplyRequired": false,
        "closeDiscardsCommittedOperations": false,
        "UndoRestoresLastOperationOnly": true
      },
      "authority": "GUI-DATA complex / GUI-GRID-004 / 0045"
    },
    {
      "id": "stable-spatial-context",
      "input": "save-both/input",
      "intent": "continue editing under pointer",
      "events": [
        "produce diagnostics",
        "open Problems",
        "finish background validation",
        "horizontal scroll",
        "vertical scroll"
      ],
      "expected": {
        "gridTopEdgeMovesForRoutineState": false,
        "ProblemsAutomaticallyOpensAndShiftsGrid": false,
        "columnHeaderRemainsVisible": true,
        "rowIdentityRemainsVisible": true,
        "outerTopLeftOverscrollGap": false
      },
      "authority": "GUI-UNIFIED / 0046 / 0049"
    },
    {
      "id": "drag-preview",
      "input": "save-both/input",
      "intent": "reorder a column and physical record row",
      "events": [
        "start drag",
        "move pointer past neighbours",
        "cancel",
        "repeat drag and drop"
      ],
      "expected": {
        "draggedColumnOrRowFollowsPointer": true,
        "neighboursPreviewNewOrder": true,
        "insertionLineRequired": false,
        "headerPreviewClippedToStickyRegion": true,
        "fieldNameHandleActionsOverlap": false,
        "cancelMutations": 0,
        "dropUndoUnits": 1,
        "otherPhysicalSourcesMutated": false
      },
      "authority": "GUI-GRID reorder / 0048 / 0049"
    },
    {
      "id": "array-reorder",
      "input": "save-both/input",
      "intent": "reorder equal-valued array occurrences",
      "events": [
        "drag second equal item ahead of first",
        "Undo",
        "start drag then Escape"
      ],
      "expected": {
        "occurrencesDistinctFromValue": true,
        "originalSourceSpellingFollowsOccurrence": true,
        "UndoRestoresOrder": true,
        "cancelMutations": 0
      },
      "authority": "SOURCE-EDIT-017 / GUI-GRID"
    },
    {
      "id": "history-navigation",
      "input": "save-both/input",
      "intent": "continue dirty authoring across sources",
      "events": [
        "edit A",
        "Add row A",
        "Delete existing row A",
        "set Search A",
        "select B",
        "edit B",
        "return A",
        "Undo A"
      ],
      "expected": {
        "dirtyAAndBIndependent": true,
        "addedDraftAndPendingDeletePreserved": true,
        "sourceLocalSearchAndSelectionPreserved": true,
        "UndoAChangesB": false,
        "navigationImplicitSaveOrDiscard": false
      },
      "authority": "GUI-GRID-004..006 / GUI-EXPLORER-NAV-001"
    },
    {
      "id": "delayed-focus",
      "input": "save-both/input",
      "intent": "keep user focus after background work",
      "events": [
        "create source",
        "move focus to other target",
        "deliver creation result again",
        "deliver stale diagnostics"
      ],
      "expected": {
        "creationFocusIntentConsumedOnce": true,
        "delayedResultStealsFocus": false,
        "staleDiagnosticsShownAsCurrent": false
      },
      "authority": "GUI-EXPLORER / 0050"
    },
    {
      "id": "rapid-navigation",
      "input": "save-both/input",
      "intent": "select final target while backend is blocked",
      "events": [
        "pause backend response A",
        "select A B C D repeatedly 50 times ending D",
        "resume responses out of order"
      ],
      "expected": {
        "selectedTargetImmediately": "D",
        "activeContentAfterDrain": "D",
        "oldContentIdentifiedAsNew": false,
        "obsoleteResponseOrFocusWins": false,
        "dirtyAndHistoryRetained": true,
        "pendingWorkBounded": true,
        "queuedObsoleteRequestsDrainedAfterD": false,
        "warmProjectWideDiscoveryEnumerationParseValidationCounts": [
          0,
          0,
          0,
          0
        ]
      },
      "authority": "GUI-EXPLORER-NAV-001 / GUI-PERF-001..004"
    },
    {
      "id": "search",
      "input": "save-both/input",
      "intent": "find a value in a large Table",
      "events": [
        "search matching scalar text",
        "move to matching occurrence",
        "clear Search"
      ],
      "expected": {
        "matchAddressUsesOccurrence": true,
        "sourceBytesChanged": false,
        "dirtyChanged": false,
        "sourceOrderAfterClearPreserved": true,
        "TypedFilterOrSortBuilderRequired": false
      },
      "authority": "GUI-BASELINE-004 / AUTHORING-QUERY-001"
    },
    {
      "id": "paste",

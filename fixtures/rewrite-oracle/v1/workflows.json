        "BuildPublishesImplicitly": false,
        "PublishReadsCurrentDirtyYAML": false,
        "PublishRejectsInvalidReceiptOrUnsafeTargets": true,
        "BuildFailureStartsPublish": false,
        "UnityMetaManagedByPublisher": false
      },

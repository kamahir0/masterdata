      "events": [
        "capture base",
        "external edit source",
        "navigate or freshness poll"
      ],
      "expected": {
        "freshSourceBecomesCurrent": true,
        "staleSnapshotEditableWithoutCheck": false,
        "unrelatedDirtySourcesRetained": true

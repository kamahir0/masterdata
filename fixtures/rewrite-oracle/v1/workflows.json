        "Undo",
        "paste range containing unsafe target"
      ],
      "expected": {
        "integerDecimalTokensLossless": true,
        "textNullDistinctFromNull": true,
        "noImplicitRowAddition": true,
        "noHiddenRowMutation": true,
        "unsafeFailurePartialChanges": 0,
        "sourceSafeDomainInvalidAllowedWithDiagnostics": true,
        "oneLogicalPasteUndoUnits": 1,
        "implicitSaveBuildMigration": false,
        "existingPKBatchRestrictionNotDirectEditRestriction": true,
        "FillOrPermanentPreviewRequired": false
      },
      "authority": "AUTHORING-BATCH-001..004 / GUI-GRID-002"
    },
    {

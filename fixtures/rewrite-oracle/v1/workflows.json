        "Save All"
      ],
      "expected": {
        "ordinaryScope": [
          "schema A",
          "source A1"
        ],
        "SaveAllSeparateExplicitScope": [
          "inactive A2",
          "B"
        ],
        "diagnosticOnlyCleanDependencyIncluded": false,
        "knownConflictPreventsAvoidablePartialWrite": true
      },
      "authority": "GUI-UNIFIED-004 / SOURCE-EDIT-007"
    },

        "Undo draft"
      ],
      "expected": {
        "recordBytesRewrittenBySchemaDraft": false,
        "currentResolvedShapeOwnsInterpretation": true,
        "semanticInvalidityCanBeSavedSafely": true,
        "baseAndDraftDistinct": true
      },
      "authority": "YAML-SUBSET-018 / GUI-UNIFIED"
    },
    {
      "id": "save-all",
      "input": "save-both/input",
      "intent": "save all dirty physical sources explicitly",
      "events": [
        "dirty schema A and source A1 and inactive A2 and B",

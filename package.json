{
  "name": "masterdata",
  "productName": "MasterData",
  "version": "0.1.0",
  "description": "構造を理解するゲームデータエディタ",
  "author": "masterdata contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "build": "npm run check && vite build && npm run prepare:host",
    "start": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "test:ui": "playwright test",
    "pack": "tauri build --config src-tauri/tauri.dev.conf.json",
    "prepare:host": "node scripts/prepare-host.mjs",
    "tauri": "tauri",
    "test:native": "node scripts/test-native.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tauri-apps/api": "^2.12.4",
    "antd": "6.6.6",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "^1.4.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.27.0",
    "node": "24.22.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.3.4"
  }
}

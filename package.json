{
  "name": "masterdata",
  "productName": "MasterData",
  "version": "0.1.0",
  "description": "構造を理解するゲームデータエディタ",
  "author": "masterdata contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run check && vite build && esbuild desktop/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=desktop/main.cjs && esbuild desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=desktop/preload.cjs",
    "start": "npm run build && electron .",
    "test:ui": "playwright test",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "6.6.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "motion": "14.3.0",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "dev.kamahir0.masterdata",
    "productName": "MasterData",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/*.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "samples/Adventure",
        "to": "sample"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage"
    },
    "icon": "assets/icon.png"
  }
}

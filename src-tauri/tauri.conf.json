{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterData",
  "version": "0.1.2",
  "identifier": "dev.kamahir0.masterdata",
  "build": {
    "beforeDevCommand": "npm run prepare:host && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MasterData",
        "width": 1480,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        },
        "backgroundColor": "#f6f6f6",
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon.png",
      "../assets/icon.icns",
      "../assets/icon.ico"
    ],
    "externalBin": [
      "binaries/masterdata-host"
    ],
    "resources": {
      "../samples/Adventure/": "sample/",
      "../.build/node-license.txt": "licenses/Node.txt"
    },
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
